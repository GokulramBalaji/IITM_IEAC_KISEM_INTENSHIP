# ==============================================================================
# IIT Madras IEAC - Environment Configuration Template
# Copy this file to .env and configure the secrets for your environment.
# Never commit your actual .env file with production secrets to Git!
# ==============================================================================

# Server Network & Runtime Configuration
PORT=3000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong 64-char random string in production)
JWT_SECRET=iitm-ieac-production-secret-replace-with-secure-random-key

# Allowed CORS Origins (comma separated list for production deployment)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://iitm-ieac.netlify.app

# Database Configuration (Supabase PostgreSQL / Cloud SQL)
# Required when running live database setups or migrations:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Client & Service Configuration (for optional Cloud Sync)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...[YOUR-ANON-KEY]
SUPABASE_SECRET_KEY=eyJhbGciOi...[YOUR-SERVICE-ROLE-KEY]

# Seeding & Initial Provisioning
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin@123
